{
  "name": "igo-api",
  "version": "1.0.0-next.32",
  "description": "IGO - API",
  "license": "LiLiQ-R",
  "workspaces": [
    "scripts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/infra-geo-ouverte/igo2-api.git"
  },
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "postinstall": "git --version > /dev/null 2>&1 && git config core.hooksPath .git-hooks || echo 'Ignore postinstall'",
    "start": "tsc --watch --noEmit & node --env-file=.env --import tsx --watch src/server.ts",
    "build": "rimraf dist && tsc -p tsconfig.app.json && npm run copy-package -w scripts",
    "format": "prettier --check ./src/**/*.{ts,js,json}",
    "format:fix": "prettier --write ./src/**/*.{ts,js,json}",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "types": "tsc --noEmit",
    "e2e": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 \"src/**/test/*.e2e.ts\"",
    "e2e:watch": "node --env-file=.env --import tsx --test --test-concurrency=1 --watch \"src/**/test/*.e2e.ts\"",
    "e2e:ci": "node --import tsx scripts/src/e2e.mts",
    "test": "node --import tsx --test \"src/**/test/*.test.ts\"",
    "database:backup": "node --env-file=.env --import tsx .devcontainer/database/scripts/backup.mts",
    "database:restore": "node --import tsx .devcontainer/database/scripts/restore.mts",
    "migration:generate": "drizzle-kit generate --config src/core/database/migration.ts",
    "migration:apply": "drizzle-kit migrate --config src/core/database/migration.ts"
  },
  "dependencies": {
    "@aws-sdk/rds-signer": "^3.1045.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/env": "^6.0.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@igo2/base-api": "^3.2.0-next.2",
    "@igo2/fastify": "^3.2.0-next.2",
    "@sentry/node": "^10.53.0",
    "@sentry/profiling-node": "^10.53.0",
    "axios": "^1.16.0",
    "camelcase": "^9.0.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "drizzle-orm": "^1.0.0-rc.4",
    "fastify": "^5.8.0",
    "lodash": "^4.18.0",
    "pg": "^8.20.0",
    "pino-pretty": "^13.1.0",
    "typebox": "~1.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@commitlint/format": "^21.0.0",
    "@commitlint/types": "^21.0.0",
    "@eslint/js": "^10.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.0",
    "@semantic-release/gitlab": "^13.3.0",
    "@semantic-release/npm": "^13.1.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@tsconfig/node24": "^24.0.0",
    "@types/lodash": "^4.17.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "eslint": "^10.3.0",
    "execa": "^9.6.0",
    "globals": "^17.6.0",
    "nock": "^14.0.10",
    "prettier": "^3.8.0",
    "rimraf": "^6.0.0",
    "semantic-release": "^24.2.9",
    "testcontainers": "^11.14.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.59.0"
  }
}
